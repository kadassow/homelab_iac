# Managed by Ansible (roles/samba) — do not edit directly.

[global]
   workgroup = WORKGROUP
   server string = vm4-storage
   security = user
   map to guest = never

[media]
   path = {{ mergerfs_mount }}/media
   valid users = @rw_media, @ro_media
   force group = rw_media
   create mask = 0660
   directory mask = 0770
   # read-only enforcement happens per-connecting-user via valid users'
   # Linux group ACLs set by roles/samba/tasks/main.yml, not here — a
   # ro_media-only account still has this share "writable" at the Samba
   # share level, but the underlying POSIX ACL (r-x for ro_media) blocks
   # the actual write at the filesystem layer.
   read only = no

[stash]
   path = {{ mergerfs_mount }}/stash
   valid users = @rw_stash
   force group = rw_stash
   create mask = 0660
   directory mask = 0770
   read only = no

[books]
   path = {{ mergerfs_mount }}/books
   valid users = @rw_books
   force group = rw_books
   create mask = 0660
   directory mask = 0770
   read only = no

[dockerconfigs]
   path = {{ mergerfs_mount }}/dockerconfigs
   valid users = @rw_dockerconfigs
   force group = rw_dockerconfigs
   create mask = 0660
   directory mask = 0770
   read only = no

[nextcloud]
   path = {{ mergerfs_mount }}/nextcloud
   valid users = @rw_nextcloud
   force group = rw_nextcloud
   create mask = 0660
   directory mask = 0770
   read only = no
