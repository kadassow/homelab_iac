# Managed by Ansible (roles/samba) — do not edit directly.

[global]
   workgroup = WORKGROUP
   server string = vm4-storage
   security = user
   map to guest = never
   server min protocol = SMB3
   disable netbios = yes
   smb ports = 445
   hosts allow = 192.168.69.0/23

# ONE share exporting the whole pool. Both Docker hosts mount this as
# DATA_DIR (/mnt/data) so downloads/ and media/ (and downloads/privatestuff
# and stash/) sit under a single mount and can be hardlinked.
#
# There is deliberately no force group and no read/write list here: who can
# read or write each top-level folder is decided by the POSIX ACLs that
# roles/samba/tasks/main.yml applies from acl_definitions (folders are 0770,
# so anyone without an ACL entry gets nothing).
[data]
   path = {{ mergerfs_mount }}
   valid users = @rw_media, @ro_media, @rw_stash, @rw_books, @admin
   inherit acls = yes
   create mask = 0660
   directory mask = 0770
   read only = no

# Separate share for DOCKERCONFIGS_DIR (small app configs/metadata/cache).
[dockerconfigs]
   path = {{ mergerfs_mount }}/dockerconfigs
   valid users = @rw_dockerconfigs, @admin
   force group = rw_dockerconfigs
   inherit acls = yes
   create mask = 0660
   directory mask = 0770
   read only = no
